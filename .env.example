# Fill in your local Postgres password, then run: npm run db:migrate && npm run db:seed
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sms?schema=public"

# Used to sign login sessions. Replace with a long random string.
AUTH_SECRET="dev-only-change-me-to-a-long-random-string-0123456789"

SCHOOL_NAME="Green Hills Primary School"
SCHOOL_CURRENCY="RWF"
